# =============================================================================
# Deal Finder Backend — Environment Template
# Copy to `.env` and fill in real values. Never commit secrets.
# =============================================================================

# Runtime
NODE_ENV=production
PROCESS_ROLE=api
# api | worker | all  — PM2 sets this per process; local `npm run dev` uses all

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/deal_finder?schema=public"

# Redis (BullMQ queues + locks)
REDIS_URL="redis://localhost:6379"

# HTTP API
PORT=3010

# Auth
JWT_SECRET="change-me-to-a-long-random-production-secret"

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Public bot username without @ (for mobile t.me deep links)
TELEGRAM_BOT_USERNAME="YourDealFinderBot"

# Evolution API / Baileys compatible WhatsApp endpoint (full send URL)
WHATSAPP_API_URL="http://localhost:8080/message/sendText/instance-name"
WHATSAPP_API_KEY="your-whatsapp-api-key"

# Absolute or relative path to Firebase service-account JSON (FCM provider)
FIREBASE_CREDENTIALS_PATH="./firebase-service-account.json"

# Host path mounted into Docker containers (docker-compose)
FIREBASE_CREDENTIALS_HOST_PATH=./firebase-service-account.json

# Expo Push API access token (optional; recommended in production for higher limits)
# Create at https://expo.dev → Account settings → Access tokens
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Scraping / anti-bot (Webshare rotating residential — TR)
# -----------------------------------------------------------------------------

PROXY_ENABLED=true
PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USER=rdlwkhau-tr-rotate
PROXY_PASS=your-webshare-password

# Composed automatically from PROXY_* above; optional overrides:
# PROXY_URL="http://user:pass@p.webshare.io:80"
# RESIDENTIAL_PROXY_URL="http://user:pass@p.webshare.io:80"

# Active UserFilter scrape interval for ScraperScheduler (default 15 minutes)
SCRAPER_SCHEDULE_INTERVAL_MS=900000

# -----------------------------------------------------------------------------
# Security / mocks / CORS
# -----------------------------------------------------------------------------

# Mock/fallback listings (dev only). Default false.
# Requires NODE_ENV !== production AND ENABLE_MOCK_LISTINGS=true
ENABLE_MOCK_LISTINGS=false

# Production CORS allowlist (comma-separated). Dev still allows localhost / Expo.
# CORS_ORIGINS=https://45.43.152.58.nip.io,https://app.example.com
CORS_ORIGINS=
# -----------------------------------------------------------------------------
# Market Intelligence / DealScore V2
# -----------------------------------------------------------------------------

# Minimum comparable sample size after outlier filter (default 5)
MARKET_MIN_SAMPLE=5

# Comparable lookback window in days (lastSeenAt; default 90)
MARKET_LOOKBACK_DAYS=90

# Global deal threshold for isDeal / match enqueue (default 70)
DEAL_SCORE_THRESHOLD=70
