    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.1.0",
    "fastify": "^5.11.3",
    "firebase-admin": "^14.2.0",
