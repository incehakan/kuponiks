  "description": "Ilan takip ve bildirim motoru backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/scraper/worker.main.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/scraper/worker.main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linter configured\"",
    "smoke:preflight": "tsx scripts/smoke/preflight.ts",
    "smoke:notification": "tsx scripts/smoke/notification.ts",
    "seed:vehicle-catalog": "tsx scripts/seed-vehicle-catalog.ts",
    "sync:vehicle-catalog": "tsx scripts/sync-vehicle-catalog-from-listings.ts",
    "scheduler:dry-run": "tsx scripts/scheduler-dry-run.ts",
    "scheduler:run-once": "tsx scripts/scheduler-run-once.ts",
    "scheduler:status": "tsx scripts/scheduler-status.ts",
    "arabam:query-verify": "tsx scripts/arabam-query-verify.ts",
    "catalog:sync:arabam": "tsx scripts/catalog-sync-arabam.ts",
    "catalog:snapshot:arabam": "tsx scripts/catalog-snapshot-arabam.ts",
    "catalog:import:snapshot": "tsx scripts/catalog-import-snapshot.ts",
    "catalog:validate:snapshot": "tsx scripts/catalog-validate-snapshot.ts",
    "catalog:status": "tsx scripts/catalog-status.ts"
  },
