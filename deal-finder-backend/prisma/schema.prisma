// Prisma schema for deal-finder notification engine
// Connection URL is configured in prisma.config.ts (Prisma ORM v7+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionPlan {
  FREE
  PRO
  VIP
}

enum NotificationChannel {
  PUSH
  WHATSAPP
  TELEGRAM
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  fullName         String
  phoneNumber      String           @unique
  passwordHash     String
  telegramChatId   String?
  fcmDeviceToken   String?
  /// Expo Push Token (ExponentPushToken[...]) for mobile push notifications
  expoPushToken    String?
  subscriptionPlan SubscriptionPlan @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  filters        UserFilter[]
  notifications  NotificationLog[]
  listingMatches UserListingMatch[]
}

model UserFilter {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  /// Optional display name for the search task (e.g. "Honda Civic Fırsatları")
  name             String?
  category         String
  subcategory      String?
  brand            String?
  model            String?
  series           String?
  trim             String?
  variant          String?
  minYear          Int?
  maxYear          Int?
  minMileage       Int?
  maxMileage       Int?
  city             String?
  district         String?
  minPrice         Float?
  maxPrice         Float?
  fuelType         String?
  transmission     String?
  sellerType       String?
  /// Optional free-text alarm keywords (e.g. "3+1", "Yeşilyurt", "otomatik")
  keywords         String[]
  /// Title/description must NOT contain these terms
  excludedKeywords String[] @default([])
  minDealScore     Int      @default(70)
  notifyTelegram   Boolean  @default(false)
  notifyPush       Boolean  @default(true)
  notifyWhatsapp   Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches UserListingMatch[]

  @@index([userId])
  @@index([isActive, category])
  @@index([isActive, brand, model])
}

model Listing {
  id                  String    @id @default(uuid()) @db.Uuid
  externalId          String    @unique
  platform            String
  title               String
  price               Float
  marketAveragePrice  Float?
  /// Semantic median from Market Intelligence (BC: also written to marketAveragePrice when READY)
  marketMedianPrice   Float?
  marketSampleSize    Int?
  marketConfidence    String?
  marketDispersionPct Float?
  priceAdvantagePct   Float?
  marketCalculatedAt  DateTime?
  marketSegmentLevel  String?
  /// READY | INSUFFICIENT_DATA | UNSUPPORTED_CATEGORY
  marketStatus        String?
  dealScore           Int
  category            String?
  subcategory         String?
  brand               String?
  model               String?
  /// Vehicle family / series (e.g. Civic). Prefer over model for Market Intelligence.
  series              String?
  /// Equipment / engine package (e.g. 1.6i VTEC Elegance).
  trim                String?
  variant             String?
  year                Int?
  mileage             Int?
  fuelType            String?
  transmission        String?
  city                String?
  district            String?
  sellerType          String?
  description         String?
  currency            String?   @default("TRY")
  imageUrl            String?
  publishedAt         DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  url                 String
  rawDetails          Json?
  createdAt           DateTime  @default(now())

  notifications NotificationLog[]
  matches       UserListingMatch[]

  @@unique([platform, externalId])
  @@index([dealScore])
  @@index([dealScore, createdAt])
  @@index([platform, city])
  @@index([category, subcategory])
  @@index([brand, model])
  @@index([brand, series])
  @@index([city, price])
  @@index([year])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

/// Persisted user-filter ↔ listing match for user-specific Deal Feed.
model UserListingMatch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  filterId  String   @db.Uuid
  listingId String   @db.Uuid
  /// DealScore snapshot at match time
  dealScore Int
  matchedAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  filter  UserFilter @relation(fields: [filterId], references: [id], onDelete: Restrict)
  listing Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, filterId, listingId])
  @@index([userId, matchedAt])
  @@index([userId, listingId])
  @@index([listingId])
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  listingId String              @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus
  /// Optional machine-readable reason (e.g. no_token, already_sent, market_not_ready)
  reason    String?
  sentAt    DateTime            @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
  @@index([channel, status])
  @@index([userId, listingId, channel, status])
}

/// Master vehicle catalog (independent of Listing rows).
model VehicleBrand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  series VehicleSeries[]

  @@index([isActive, name])
}

model VehicleSeries {
  id             String   @id @default(uuid()) @db.Uuid
  brandId        String   @db.Uuid
  name           String
  normalizedName String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand VehicleBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trims VehicleTrim[]

  @@unique([brandId, normalizedName])
  @@index([brandId, isActive])
}

model VehicleTrim {
  id             String   @id @default(uuid()) @db.Uuid
  seriesId       String   @db.Uuid
  name           String
  normalizedName String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  series VehicleSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, normalizedName])
  @@index([seriesId, isActive])
}
